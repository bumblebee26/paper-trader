#!/bin/bash
# First-boot setup for the paper-trader server (rendered by Terraform, runs once as root).
# Bash variables are written as $NAME (no braces) so Terraform leaves them alone.
set -euo pipefail
exec > >(tee -a /var/log/paper-trader-bootstrap.log) 2>&1
echo "=== paper-trader bootstrap started $(date) ==="

REGION="${region}"
PREFIX="${param_prefix}"
REPO="${github_repo}"
BRANCH="${github_branch}"
APP=/home/ubuntu/paper-trader
SSH_DIR=/home/ubuntu/.ssh

timedatectl set-timezone Asia/Kolkata
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y python3-venv git curl
snap install aws-cli --classic || true
AWS=/snap/bin/aws

# --- read-only GitHub deploy key from SSM ---
install -d -m 700 -o ubuntu -g ubuntu $SSH_DIR
$AWS ssm get-parameter --region $REGION --with-decryption \
  --name "$PREFIX/github_deploy_key" --query Parameter.Value --output text > $SSH_DIR/paper_trader
chmod 600 $SSH_DIR/paper_trader
if ! grep -q "github-paper-trader" $SSH_DIR/config 2>/dev/null; then
  cat >> $SSH_DIR/config <<'EOF'
Host github-paper-trader
  HostName github.com
  User git
  IdentityFile ~/.ssh/paper_trader
  IdentitiesOnly yes
EOF
fi
ssh-keyscan -t ed25519 github.com >> $SSH_DIR/known_hosts 2>/dev/null
chown -R ubuntu:ubuntu $SSH_DIR

# --- clone; waits up to 2 hours for you to add the deploy key on GitHub ---
for i in $(seq 1 240); do
  if sudo -u ubuntu -H git clone -b "$BRANCH" "git@github-paper-trader:$REPO.git" "$APP"; then
    break
  fi
  echo "Clone failed (attempt $i). Add the deploy key on GitHub; retrying in 30s."
  sleep 30
done
[ -d "$APP/.git" ] || { echo "Gave up waiting for the deploy key."; exit 1; }

# --- Python environment ---
sudo -u ubuntu -H python3 -m venv "$APP/.venv"
sudo -u ubuntu -H "$APP/.venv/bin/pip" install -q -r "$APP/requirements.txt"

# --- .env from SSM (script lives in the repo so you can re-run it after changing secrets) ---
sudo -u ubuntu -H env AWS_REGION=$REGION PARAM_PREFIX=$PREFIX \
  CLAUDE_MODEL="${claude_model}" MAX_BUDGET_USD="${max_budget_usd}" \
  bash "$APP/aws/write_env.sh"

# --- Claude Code (installs to ~/.local/bin/claude) ---
sudo -u ubuntu -H bash -c 'curl -fsSL https://claude.ai/install.sh | bash'

# --- schedule ---
chmod +x "$APP/aws/run_session.sh"
sudo -u ubuntu -H crontab "$APP/aws/crontab.txt"

# --- tell the user on Telegram ---
sudo -u ubuntu -H bash -c "cd $APP && .venv/bin/python -c \"import telegram_bot as t; t.send('[MOCK] AWS server is set up. First session: next weekday 09:18 IST.')\"" || true
echo "=== paper-trader bootstrap finished $(date) ==="
