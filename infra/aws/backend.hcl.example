# Copy to backend.hcl (git-ignored). Same state bucket as stocks_lakehouse, own key.
#   terraform init -backend-config=backend.hcl

bucket       = "stocks-lakehouse-tfstate-<aws-account-id>"
key          = "paper-trader/aws/terraform.tfstate"
region       = "ap-southeast-2"
encrypt      = true
use_lockfile = true
