---
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
%% Shared platform view: stocks_lakehouse + paper-trader.
%% The same file lives in bumblebee26/paper-trader as docs/diagrams/01_platform.mmd; keep them identical.
%% Secrets (SSM) and deployments (CI/CD) are left out on purpose: see 04_cicd and the security tables.
flowchart TB
    subgraph SRC["Data sources"]
        direction LR
        NSE["<b>NSE</b><br/>daily bhavcopy · index file (India VIX)"]
        MAS["<b>Massive</b><br/>US stocks"]
        FRED["<b>FRED</b><br/>global series"]
        YF["<b>Yahoo Finance</b><br/>intraday NSE prices · world markets"]
    end

    subgraph AWS["AWS account · free plan · ap-southeast-2 (Sydney)"]
        direction LR
        subgraph LHA["stocks_lakehouse"]
            direction TB
            FET["<b>Fetcher Lambdas</b><br/>NSE 19:30 · Massive 11:00 · FRED 06:00 · F&amp;O Mon 08:00"]
            S3L[("<b>S3 landing bucket</b><br/>raw archive")]
            PM["<b>Pre-market Lambda</b><br/>08:45 pre-open snapshot<br/>brief + technical scanner"]
            NEWS["<b>News Lambda</b><br/>NSE filings every minute 09:00–15:59<br/>(every 30 min otherwise)<br/>Business Standard · RBI · SEBI every few min"]
        end
        subgraph PTA["paper-trader"]
            direction TB
            KICK["<b>Kicker Lambda</b><br/>09:08 · 12:27"]
            GUARD["<b>Guardian Lambda</b><br/>09:45 scanner check · 15:12 square-off · 15:14 swing into NIFTYBEES<br/>15:40 report · 15:45 export · 15:50 swing shadows<br/>23:30 late export · Fri weekly report"]
            S3T[("<b>Trader state bucket</b><br/>ledger · pools · journal · reports")]
            RESP["<b>Responder Lambda</b><br/>commands + your own orders<br/>when no session"]
        end
    end

    subgraph GHA["GitHub Actions"]
        direction TB
        SESS["<b>Trading session</b><br/>Claude Code + paper-trader MCP<br/>09:08–12:25 · 12:27–15:25"]
        FUND["<b>Company fundamentals</b><br/>Sat 07:15 · no Claude"]
        SHAD["<b>Long-term shadow</b><br/>Sat 10:15 · no Claude<br/>quality picks · momentum"]
        MODL["<b>Shadow models</b><br/>Mon–Fri 16:10 · no Claude"]
    end

    subgraph DBX["Databricks Free Edition · catalog stocks"]
        direction TB
        VOL[("<b>Landing volume</b><br/>nse · massive · fred · premarket · trades<br/>portfolio · fundamentals · index_members")]
        NVOL[("<b>News volume</b><br/>latest.jsonl")]
        PIPE["<b>3 pipelines, one at a time</b><br/>market → research · trading<br/>bronze → silver → gold"]
        GOLD["<b>Gold tables</b><br/>markets · scanner · trading · portfolio · long-term"]
        WH["<b>SQL warehouse</b>"]
        DASH["<b>Dashboard</b><br/>Desk · Intraday · Swing<br/>Long term · Your calls · Global markets"]
        VOL --> PIPE --> GOLD --> WH --> DASH
        NVOL --> PIPE
    end

    TG["<b>Telegram · you</b><br/>brief · plan · YES/NO · LEDGER · report"]

    NSE & MAS & FRED --> FET
    FET -- "raw file" --> S3L
    FET -- "push (Files API)" --> VOL
    NSE --> NEWS
    NEWS -- "push" --> NVOL
    PM -- "SQL" --> WH
    YF -- "world markets" --> PM
    PM -- "08:45 pre-open snapshot" --> VOL
    PM -- "08:45 brief" --> TG
    KICK -- "workflow_dispatch" --> SESS
    SESS -- "pre-market context (SQL)" --> WH
    YF -- "prices" --> SESS
    NVOL -- "company news (Files API)" --> SESS
    YF -- "financials" --> FUND
    FUND -- "Sat: fundamentals + Nifty 200" --> VOL
    WH -- "Sat: long-term picks + momentum" --> SHAD
    WH -- "16:10 tradable list (SQL)" --> MODL
    YF -- "5-min candles" --> MODL
    MODL -- "results · journal" --> S3T
    SHAD -- "shadow ledger" --> S3T
    SHAD -- "weekly shadow report" --> TG
    SESS <-- "ledger" --> S3T
    SESS <-- "proposals · YES/NO" --> TG
    GUARD <-- "backstops" --> S3T
    GUARD -- "15:45 journal + portfolio" --> VOL
    WH -- "09:45 scanner · 15:50 swing signals (SQL)" --> GUARD
    RESP <-- "commands, any time" --> TG
    RESP -- "/analyze (SQL)" --> WH

    classDef ext fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef aws fill:#fff7ed,stroke:#f59e0b,color:#451a03
    classDef store fill:#fffbeb,stroke:#d97706,color:#451a03
    classDef trader fill:#f5f3ff,stroke:#8b5cf6,color:#2e1065
    classDef dbx fill:#fef2f2,stroke:#ef4444,color:#450a0a
    classDef gold fill:#fef9c3,stroke:#ca8a04,color:#422006
    classDef out fill:#ecfdf5,stroke:#10b981,color:#022c22
    class NSE,MAS,FRED,YF ext
    class FET,PM,NEWS aws
    class S3L store
    class KICK,GUARD,S3T,SESS,RESP,FUND,SHAD,MODL trader
    class VOL,NVOL,PIPE,WH dbx
    class GOLD gold
    class DASH,TG out
