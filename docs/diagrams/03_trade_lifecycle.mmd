---
config:
  layout: elk
---
flowchart LR
    C["<b>Candidate</b><br/>ORB · VWAP · PDH/PDL<br/>from run_cycle"]
    J{"Claude: fits rules<br/>and day plan?"}
    G{"<b>Risk gate</b> (code)<br/>window · limits · R:R<br/>size from day risk %"}
    P["<b>Proposal on Telegram</b><br/>3 reasons · invalid-if<br/>valid 3 min"]
    D{"Your reply"}
    R{"<b>Re-check</b> (code)<br/>still valid · price drift<br/>· stop not hit"}
    F["<b>Simulated fill</b><br/>slippage + Rs 20"]
    X["<b>Exit</b><br/>target · stop · EXIT msg<br/>· 15:10 square-off"]
    JN[("<b>Journal</b><br/>every step, event_id")]
    E["<b>15:45 export</b><br/>→ lakehouse gold"]

    C --> J
    J -- "no" --> SKIP1["not proposed"]
    J -- "yes" --> G
    G -- "blocked" --> JN
    G -- "ok" --> P --> D
    D -- "NO" --> JN
    D -- "no reply" --> JN
    D -- "YES" --> R
    R -- "moved / expired" --> JN
    R -- "ok" --> F --> X --> JN
    JN --> E

    classDef code fill:#fff7ed,stroke:#f59e0b,color:#451a03
    classDef you fill:#ecfdf5,stroke:#10b981,color:#022c22
    classDef claude fill:#f5f3ff,stroke:#8b5cf6,color:#2e1065
    classDef store fill:#fffbeb,stroke:#d97706,color:#451a03
    class G,R,F,X code
    class P,D you
    class C,J claude
    class JN,E store
