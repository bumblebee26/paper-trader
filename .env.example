# Laptop mode only (Claude Desktop). Copy to .env and fill in the token. Never share .env.
# In GitHub Actions and Lambda these come from SSM instead.
TELEGRAM_BOT_TOKEN=paste-your-token-from-BotFather
TELEGRAM_CHAT_ID=8674025639
ALLOWED_USER_ID=8674025639

# Optional: lakehouse pre-market data on your laptop (needs AWS credentials for SSM).
# DATABRICKS_URL_PARAM=/stocks/databricks-workspace-url
# DATABRICKS_TOKEN_PARAM=/stocks/databricks-pusher-token
# DATABRICKS_WAREHOUSE_PARAM=/stocks/databricks-warehouse-id

# Dummy money and risk rules (optional; these are the defaults)
STARTING_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=5
DAILY_LOSS_LIMIT_PCT=2.0
MIN_RR=1.5
INTRADAY_LEVERAGE=5
SLIPPAGE_PCT=0.05
BROKERAGE_PER_ORDER=20
APPROVAL_TIMEOUT_SEC=180
ENTRY_TOLERANCE_PCT=0.3
ENTRY_START=09:30
ENTRY_END=14:30
SQUARE_OFF=15:10
