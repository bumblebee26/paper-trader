# Copy this file to .env and fill in the first line. Never share .env.
TELEGRAM_BOT_TOKEN=paste-your-token-from-BotFather
TELEGRAM_CHAT_ID=8674025639
ALLOWED_USER_ID=8674025639

# Only for the AWS server (Claude Code headless). Fill ONE of these two:
# - Claude Pro/Max subscription: run `claude setup-token` on your laptop and paste the token
# - Pay-per-use API key from platform.claude.com
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=sonnet
MAX_BUDGET_USD=2

# Dummy money and risk rules (optional; these are the defaults)
STARTING_CAPITAL=1000000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=5
DAILY_LOSS_LIMIT_PCT=2.0
MIN_RR=1.5
INTRADAY_LEVERAGE=5
SLIPPAGE_PCT=0.05
BROKERAGE_PER_ORDER=20
APPROVAL_TIMEOUT_SEC=180
ENTRY_TOLERANCE_PCT=0.3
ENTRY_START=09:30
ENTRY_END=14:30
SQUARE_OFF=15:10
